{% extends 'base.html.twig' %}

{% block body %}
<div class="max-w-2xl mx-auto px-4 md:px-8 py-6">

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6">
        <div class="rounded-xl bg-white dark:bg-slate-800 border border-stone-200 dark:border-slate-700 p-4">
            <div class="w-9 h-9 rounded-lg bg-violet-600 flex items-center justify-center mb-2">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <p class="text-2xl font-bold text-stone-900 dark:text-stone-100">{{ nbTotal }}</p>
            <p class="text-sm text-stone-500 dark:text-stone-400">Total</p>
        </div>

        <div class="rounded-xl bg-white dark:bg-slate-800 border border-stone-200 dark:border-slate-700 p-4">
            <div class="w-9 h-9 rounded-lg bg-orange-500 flex items-center justify-center mb-2">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <p class="text-2xl font-bold text-stone-900 dark:text-stone-100">{{ nbAFaire }}</p>
            <p class="text-sm text-stone-500 dark:text-stone-400">En attente</p>
        </div>

        <div class="rounded-xl bg-white dark:bg-slate-800 border border-stone-200 dark:border-slate-700 p-4">
            <div class="w-9 h-9 rounded-lg bg-blue-500 flex items-center justify-center mb-2">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <p class="text-2xl font-bold text-stone-900 dark:text-stone-100">{{ nbEnCours }}</p>
            <p class="text-sm text-stone-500 dark:text-stone-400">En cours</p>
        </div>

        <div class="rounded-xl bg-white dark:bg-slate-800 border border-stone-200 dark:border-slate-700 p-4">
            <div class="w-9 h-9 rounded-lg bg-green-500 flex items-center justify-center mb-2">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
            </div>
            <p class="text-2xl font-bold text-stone-900 dark:text-stone-100">{{ nbTermine }}</p>
            <p class="text-sm text-stone-500 dark:text-stone-400">Terminées</p>
        </div>
    </div>

    {% set circonference = 2 * 3.14159 * 50 %}

    <div class="mt-6 rounded-xl bg-white dark:bg-slate-800 border border-stone-200 dark:border-slate-700 p-6">
        <p class="font-semibold text-stone-700 dark:text-stone-200 mb-4">Taux de complétion</p>

        <div class="flex items-center gap-6">
            <svg viewBox="0 0 120 120" class="w-32 h-32 -rotate-90 shrink-0">
                <circle cx="60" cy="60" r="50" fill="none" stroke-width="12"
                        class="stroke-stone-200 dark:stroke-slate-700" />

                {# Segment Terminé - démarre à 0% #}
                <circle cx="60" cy="60" r="50" fill="none" stroke-width="12"
                        class="stroke-green-500"
                        stroke-dasharray="{{ circonference }}"
                        stroke-dashoffset="{{ (circonference * (1 - pourcentageTermine / 100))|round(2) }}" />

                {# Segment En cours - démarre après "Terminé" #}
                <circle cx="60" cy="60" r="50" fill="none" stroke-width="12"
                        class="stroke-blue-500"
                        stroke-dasharray="{{ circonference }}"
                        stroke-dashoffset="{{ (circonference * (1 - pourcentageEnCours / 100) + circonference * (pourcentageTermine / 100))|round(2) }}" />

                {# Segment À faire - démarre après "Terminé" + "En cours" #}
                <circle cx="60" cy="60" r="50" fill="none" stroke-width="12"
                        class="stroke-orange-500"
                        stroke-dasharray="{{ circonference }}"
                        stroke-dashoffset="{{ (circonference * (1 - pourcentageAFaire / 100) + circonference * ((pourcentageTermine + pourcentageEnCours) / 100))|round(2) }}" />
            </svg>

            <div class="space-y-2">
                <div class="flex items-center gap-2 text-sm">
                    <span class="w-2.5 h-2.5 rounded-full bg-green-500"></span>
                    <span class="text-stone-600 dark:text-stone-300">Terminées</span>
                    <span class="text-stone-400 ml-auto">{{ nbTermine }} ({{ pourcentageTermine|round }}%)</span>
                </div>
                <div class="flex items-center gap-2 text-sm">
                    <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
                    <span class="text-stone-600 dark:text-stone-300">En cours</span>
                    <span class="text-stone-400 ml-auto">{{ nbEnCours }} ({{ pourcentageEnCours|round }}%)</span>
                </div>
                <div class="flex items-center gap-2 text-sm">
                    <span class="w-2.5 h-2.5 rounded-full bg-orange-500"></span>
                    <span class="text-stone-600 dark:text-stone-300">En attente</span>
                    <span class="text-stone-400 ml-auto">{{ nbAFaire }} ({{ pourcentageAFaire|round }}%)</span>
                </div>
            </div>
        </div>
    </div>
    
</div>
{% endblock %}