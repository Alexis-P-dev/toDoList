{% extends 'base.html.twig' %}

{% block body %}
<div class="max-w-2xl mx-auto px-4 md:px-8 py-6">

    {% for message in app.flashes('erreur') %}
        <p class="mb-4 rounded-lg bg-red-50 dark:bg-red-500/10 px-4 py-3 text-sm text-red-700 dark:text-red-400 border border-red-200 dark:border-red-500/30">{{ message }}</p>
    {% endfor %}

    {# input new todo #}
    <div class="flex items-center justify-between rounded-xl bg-white dark:bg-slate-800 border border-stone-200 dark:border-slate-700 px-4 py-3 mb-4 focus-within:border-violet-300 dark:focus-within:border-violet-500 transition-colors">
        <input type="text" id="todoTitre" placeholder="Ajouter une tâche..."
            class="flex-1 bg-transparent text-stone-800 dark:text-stone-100 placeholder-stone-400 dark:placeholder-stone-500 focus:outline-none">
        <button type="button"
                onclick="document.getElementById('modaleTitre').value = document.getElementById('todoTitre').value; document.getElementById('modale-nouveau').showModal();"
                class="shrink-0 flex items-center justify-center w-10 h-7 rounded-lg bg-violet-600 hover:bg-violet-500 text-white text-lg leading-none text-center active:scale-95 transition-all">
            +
        </button>
    </div>

    {# popup new todo #}
    <dialog id="modale-nouveau" class="sheet fixed inset-x-0 bottom-0 top-auto m-0 w-full max-w-full rounded-t-2xl p-6 bg-white dark:bg-slate-800">
        <div class="flex justify-end">
            <button type="button" onclick="document.getElementById('modale-nouveau').close()"
                    class="text-stone-400 hover:text-stone-600 dark:hover:text-stone-200 active:scale-95 transition-all">✕</button>
        </div>

        <h3 class="text-center font-bold text-lg text-stone-900 dark:text-stone-100 mt-2 mb-6">Nouvelle tâche</h3>

        <form method="post" action="{{ path('todo_nouveau') }}" class="space-y-4">
            <div>
                <label for="modaleTitre" class="block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1">Titre</label>
                <input type="text" name="titre" id="modaleTitre"
                    class="w-full rounded-lg border border-stone-300 dark:border-slate-600 bg-white dark:bg-slate-800 px-4 py-2.5 text-stone-900 dark:text-stone-100 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-violet-500">
            </div>

            <div>
                <label for="modaleDateFin" class="block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1">Date d'échéance (optionnel)</label>
                <input type="date" name="dateFin" id="modaleDateFin"
                    class="w-full rounded-lg border border-stone-300 dark:border-slate-600 bg-white dark:bg-slate-800 px-4 py-2.5 text-stone-900 dark:text-stone-100 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-violet-500">
            </div>

            <div>
                <label class="block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1">Durée (optionnel)</label>
                <div class="flex items-center gap-2">
                    <input type="number" name="heures" id="heures" placeholder="h"
                        class="w-full rounded-lg border border-stone-300 dark:border-slate-600 bg-white dark:bg-slate-800 px-4 py-2.5 text-stone-900 dark:text-stone-100 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-violet-500">
                    <input type="number" name="minutes" id="minutes" min="0" max="59" placeholder="min"
                        class="w-full rounded-lg border border-stone-300 dark:border-slate-600 bg-white dark:bg-slate-800 px-4 py-2.5 text-stone-900 dark:text-stone-100 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-violet-500 out-of-range:border-red-500">
                </div>
            </div>
            
            <div>
                <label for="modaleImportance" class="block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1">Importance</label>
                <select name="importance" id="modaleImportance"
                        class="w-full rounded-lg border border-stone-300 dark:border-slate-600 bg-white dark:bg-slate-800 px-4 py-2.5 text-stone-900 dark:text-stone-100 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-violet-500">
                    <option value="urgente">🔴 Urgente</option>
                    <option value="importante">🟠 Importante</option>
                    <option value="normale" selected>🟢 Normale</option>
                </select>
            </div>

            <button type="submit"
                    class="w-full rounded-lg bg-violet-600 hover:bg-violet-500 px-4 py-2.5 text-sm font-semibold text-white shadow-sm active:scale-95 transition-all">
                Ajouter la tâche
            </button>
        </form>
    </dialog>

    {# Filtre todo #}
    <div class="flex items-center gap-2 mb-6">
        <a href="{{ path('todo_liste') }}"
        class="flex-1 sm:flex-none rounded-lg text-sm font-medium px-2 sm:px-4 py-2 text-center {% if filtre is null %}bg-violet-600 text-white{% else %}text-stone-500 dark:text-stone-400 hover:bg-stone-100 dark:hover:bg-slate-800{% endif %}">
            Toutes
        </a>
        <a href="{{ path('todo_liste', {filtre: 'a_faire'}) }}"
        class="flex-1 sm:flex-none rounded-lg text-sm font-medium px-2 sm:px-4 py-2 text-center {% if filtre == 'a_faire' %}bg-violet-600 text-white{% else %}text-stone-500 dark:text-stone-400 hover:bg-stone-100 dark:hover:bg-slate-800{% endif %}">
            À faire
        </a>
        <a href="{{ path('todo_liste', {filtre: 'en_cours'}) }}"
        class="flex-1 sm:flex-none rounded-lg text-sm font-medium px-2 sm:px-4 py-2 text-center {% if filtre == 'en_cours' %}bg-violet-600 text-white{% else %}text-stone-500 dark:text-stone-400 hover:bg-stone-100 dark:hover:bg-slate-800{% endif %}">
            En cours
        </a>
        <a href="{{ path('todo_liste', {filtre: 'termine'}) }}"
        class="flex-1 sm:flex-none rounded-lg text-sm font-medium px-2 sm:px-4 py-2 text-center {% if filtre == 'termine' %}bg-violet-600 text-white{% else %}text-stone-500 dark:text-stone-400 hover:bg-stone-100 dark:hover:bg-slate-800{% endif %}">
            Terminées
        </a>
    </div>

    <ul class="space-y-3">
        {% for todo in todos %}
            <li class="flex items-center gap-3 rounded-xl bg-white dark:bg-slate-800 border border-stone-200 dark:border-slate-700 px-4 py-4 shadow-sm hover:-translate-y-0.5 hover:shadow-md transition-all">

                {# Changement statut #}
                <button type="button" onclick="document.getElementById('modale-{{ todo.id }}').showModal()"
                    class="relative shrink-0 flex items-center justify-center w-6 h-6 rounded-full border-2 active:scale-95 transition-all {% if todo.statut.value == 'termine' %}bg-green-600 border-green-600{% elseif todo.statut.value == 'en_cours' %}bg-transparent border-transparent{% else %}border-stone-300 dark:border-slate-600{% endif %}">

                    {% if todo.statut.value == 'termine' %}
                        <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                            <path class="checkmark-path" stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                    {% elseif todo.statut.value == 'en_cours' %}
                        <svg class="absolute inset-0 w-full h-full text-blue-600" viewBox="0 0 24 24" stroke="currentColor">
                            <circle class="loading-circle" cx="12" cy="12" r="11" />
                        </svg>
                    {% endif %}
                </button>

                <dialog id="modale-{{ todo.id }}" class="sheet fixed inset-x-0 bottom-0 top-auto m-0 w-full max-w-full rounded-t-2xl p-6 bg-white dark:bg-slate-800">
                    <div class="flex justify-end">
                        <button type="button" onclick="document.getElementById('modale-{{ todo.id }}').close()"
                                class="text-stone-400 hover:text-stone-600 dark:hover:text-stone-200">✕</button>
                    </div>

                    <h3 class="text-center font-bold text-lg text-stone-900 dark:text-stone-100 mt-2">Marquer cette tâche comme...</h3>
                    <p class="text-center text-sm text-stone-500 dark:text-stone-400 mt-1 mb-6">Choisissez le statut de cette tâche</p>

                    <div class="space-y-3">
                        <form method="post" action="{{ path('todo_statut', {id: todo.id, statut: 'a_faire'}) }}">
                            <button type="submit" class="w-full flex items-center gap-3 text-left rounded-xl border border-stone-200 dark:border-slate-700 px-4 py-3 hover:bg-stone-50 dark:hover:bg-slate-700 active:scale-95 transition-all">
                                <span class="shrink-0 w-6 h-6 rounded-full border-2 border-stone-300 dark:border-slate-600"></span>
                                <span>
                                    <span class="block font-semibold text-stone-900 dark:text-stone-100">À faire</span>
                                    <span class="block text-sm text-stone-500 dark:text-stone-400">Remettre cette tâche en attente</span>
                                </span>
                            </button>
                        </form>

                        <form method="post" action="{{ path('todo_statut', {id: todo.id, statut: 'en_cours'}) }}">
                            <button type="submit" class="w-full flex items-center gap-3 text-left rounded-xl border border-stone-200 dark:border-slate-700 px-4 py-3 hover:bg-stone-50 dark:hover:bg-slate-700 active:scale-95 transition-all">
                                <span class="shrink-0 w-6 h-6 rounded-full border-2 border-blue-600"></span>
                                <span>
                                    <span class="block font-semibold text-stone-900 dark:text-stone-100">En cours</span>
                                    <span class="block text-sm text-stone-500 dark:text-stone-400">Je commence à travailler dessus</span>
                                </span>
                            </button>
                        </form>

                        <form method="post" action="{{ path('todo_statut', {id: todo.id, statut: 'termine'}) }}">
                            <button type="submit" class="w-full flex items-center gap-3 text-left rounded-xl border border-stone-200 dark:border-slate-700 px-4 py-3 hover:bg-stone-50 dark:hover:bg-slate-700 active:scale-95 transition-all">
                                <span class="shrink-0 flex items-center justify-center w-6 h-6 rounded-full bg-green-600">
                                    <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                    </svg>
                                </span>
                                <span>
                                    <span class="block font-semibold text-stone-900 dark:text-stone-100">Terminée</span>
                                    <span class="block text-sm text-stone-500 dark:text-stone-400">J'ai terminé cette tâche</span>
                                </span>
                            </button>
                        </form>

                    </div>
                </dialog>
                
                {# Titre todo #}
                <span class="flex-1 font-medium text-sm sm:text-base {% if todo.statut.value == 'termine' %}line-through text-stone-400 dark:text-stone-500{% else %}text-stone-800 dark:text-stone-100{% endif %}">{{ todo.titre }}</span>
                
                {# Durée todo #}
                {% if todo.duree %}
                    <span class="text-xs text-stone-400 dark:text-stone-500">
                        {% if todo.duree < 60 %}
                            {{ todo.duree }} min
                        {% elseif todo.duree % 60 == 0 %}
                            {{ (todo.duree / 60)|round(0, 'floor') }}h
                        {% else %}
                            {{ (todo.duree / 60)|round(0, 'floor') }}h {{ todo.duree % 60 }}min
                        {% endif %}
                    </span>
                {% endif %}

                {# Date todo #}
                {% if todo.dateFin %}
                    <span class="text-xs text-stone-400 dark:text-stone-500">
                        {% if todo.dateFin|date('Y-m-d') == "now"|date('Y-m-d') %}
                            Aujourd'hui
                        {% elseif todo.dateFin|date('Y-m-d') == "now"|date_modify('+1 day')|date('Y-m-d') %}
                            Demain
                        {% else %}
                            {{ todo.dateFin|date('d/m/Y') }}
                        {% endif %}
                    </span>
                {% endif %}

                {# Importance todo #}
                <span class="w-2.5 h-2.5 rounded-full {% if todo.importance.value == 'normale' %}bg-green-600{% elseif todo.importance.value == 'importante' %}bg-orange-600{% else %}bg-red-600{% endif %}"></span>

                {# Modifier todo #}
                <a href="{{ path('todo_modifier', {id: todo.id}) }}"
                   class="shrink-0 rounded-lg p-2 text-stone-400 dark:text-stone-500 hover:bg-stone-100 dark:hover:bg-slate-700 hover:text-stone-600 dark:hover:text-stone-300 active:scale-95 transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                </a>
                
                {# Suprimer todo #}
                <form method="post" action="{{ path('todo_supprimer', {id: todo.id}) }}" class="shrink-0">
                    <button type="submit"
                            class="rounded-lg p-2 text-stone-400 dark:text-stone-500 hover:bg-red-50 dark:hover:bg-red-500/10 hover:text-red-500 active:scale-95 transition-all">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                    </button>
                </form>

            </li>
        {% else %}
            <li class="rounded-xl border border-dashed border-stone-300 dark:border-slate-700 px-5 py-14 text-center">
                <p class="font-semibold text-stone-700 dark:text-stone-200">Restez organisé !</p>
                <p class="mt-1 text-sm text-stone-400 dark:text-stone-500">Ajoutez vos tâches et accomplissez-les chaque jour.</p>
            </li>
        {% endfor %}

        {# tacheNow #}
        {% if tacheNow and filtre is null %}
            <div class="mt-8 rounded-2xl bg-violet-600 p-6 text-white">
                <p class="text-sm font-medium opacity-80">🎯 Maintenant</p>
                <h3 class="text-xl font-bold mt-1">{{ tacheNow.titre }}</h3>

                <div class="flex items-center gap-3 mt-2 text-sm opacity-90">
                    {% if tacheNow.duree %}
                        <span>⏱ 
                            {% if tacheNow.duree < 60 %}
                                {{ tacheNow.duree }} min
                            {% elseif tacheNow.duree % 60 == 0 %}
                                {{ (tacheNow.duree / 60)|round(0, 'floor') }}h
                            {% else %}
                                {{ (tacheNow.duree / 60)|round(0, 'floor') }}h {{ tacheNow.duree % 60 }}min
                            {% endif %}
                        </span>
                    {% endif %}

                    {% if tacheNow.importance.value == 'urgente' %}
                        <span>🔴 Urgente</span>
                    {% elseif tacheNow.importance.value == 'importante' %}
                        <span>🟠 Importante</span>
                    {% else %}
                        <span>🟢 Normale</span>
                    {% endif %}
                </div>

                <button type="button"
                        onclick="document.getElementById('modale-{{ tacheNow.id }}').showModal()"
                        class="mt-4 w-full rounded-lg bg-white text-violet-600 font-semibold py-2.5 active:scale-95 transition-all">
                    Commencer
                </button>
            </div>
        {% endif %}
    </ul>

</div>
{% endblock %}